{
  "name": "lead-ops-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "reset": "node scripts/reset-demo-state.mjs",
    "worker:crm-sync": "tsx src/jobs/crmSyncWorker.ts",
    "test": "vitest run",
    "test:public": "vitest run tests/public",
    "test:hidden": "vitest run reviewer/hidden-tests",
    "reviewer:verify-hidden": "node scripts/verify-hidden-tests.mjs",
    "reviewer:verify-baseline": "node scripts/verify-hidden-tests.mjs --expect-baseline-failures"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  }
}
